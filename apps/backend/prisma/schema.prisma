datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

// 1. Users (System Login & Access Control Accounts ONLY)
model User {
  id           String            @id @default(cuid())
  username     String            @unique
  password     String
  name         String
  email        String            @unique
  roleId       String            // e.g. role_super_admin, role_branch_head, role_admin, role_manager, role_frontdesk
  branchId     String
  locationId   String
  departmentId String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt
  deletedAt    DateTime?

  // Optional link to counselor profile
  counselorProfile CounselorProfile?

  @@index([branchId, deletedAt])
}

// 2. Counselor Profile (Independent Operational Entity in DB)
model CounselorProfile {
  id                String    @id @default(cuid())
  name              String    @default("Counselor")
  email             String?
  phone             String?
  roleId            String    @default("role_counselor")
  departmentId      String    @default("dept_sales")
  departmentName    String    @default("Sales")
  branchId          String    @default("branch_jntu1")
  branchName        String    @default("1st Campus (JNTU-HYD)")
  location          String    @default("Hyderabad")
  availability      String[]  @default(["09:00 AM - 06:00 PM"])
  status            String    @default("Available") // Available, Busy, Offline, Break
  assignedStudentId String?   @unique
  assignedStudent   Student?  @relation("CounselorStudent", fields: [assignedStudentId], references: [id])
  
  // Optional link to a user account
  userId            String?   @unique
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessions          CounselingSession[] @relation("CounselorSessions")
  convertedLeads    ConvertedLead[] @relation("CounselorConvertedLeads")
  attendances       CounselorAttendance[] @relation("CounselorAttendances")
  breaks            CounselorBreak[] @relation("CounselorBreaks")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt
  deletedAt         DateTime?
  version           Int       @default(0)

  @@index([branchId, status, deletedAt])
}

// 3. Students (Walk-in registry logs)
model Student {
  id               String            @id @default(cuid())
  name             String
  phone            String            @unique
  email            String?           @unique
  course           String
  branchId         String            @default("branch_jntu1")
  branchName       String            @default("1st Campus (JNTU-HYD)")
  walkinDate       DateTime          @default(now())
  status           String            // Waiting, Assigned, In Session, Completed, Follow-up, No Show, Cancelled
  remarks          String?           @db.Text
  source           String            @default("Walk-in")
  details          Json?             // Extra data fields stored as Json
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  version          Int               @default(0)

  // Relationships
  sessions         CounselingSession[]
  queueEntry       QueueEntry?
  assignedCounselor CounselorProfile?   @relation("CounselorStudent")

  @@index([branchId, status, deletedAt])
  @@index([createdAt, deletedAt])
}

// 4. Queue Entries (Active Tokens)
model QueueEntry {
  id        String    @id // Maps to Token ID (integer converted to string, or cuid)
  studentId String    @unique
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  position  Int
  status    String    // active, completed
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt])
}

// 5. Counseling Sessions
model CounselingSession {
  id             String            @id @default(cuid())
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counselorId    String
  counselor      CounselorProfile  @relation("CounselorSessions", fields: [counselorId], references: [id], onDelete: Cascade)
  startTime      DateTime?
  endTime        DateTime?
  duration       Int?              // Duration in seconds
  status         String            // ASSIGNED, IN_SESSION, COMPLETED, CANCELLED
  notes          String?           @db.Text
  followUpStatus String?
  audioUrl       String?
  transcript     String?           @db.Text
  summary        String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([studentId, counselorId, status, deletedAt])
  @@index([createdAt, deletedAt])
}

// 6. Audit Logs
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  module    String
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  timestamp DateTime @default(now())

  @@index([timestamp])
}

// 7. Failed Walk-in Logs
model FailedWalkin {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  course     String
  branchId   String
  branchName String
  source     String
  reason     String
  details    Json?
  createdAt  DateTime @default(now())
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([createdAt])
}

// 8. Outgoing Webhooks Subscriptions
model WebhookSubscription {
  id            String       @id @default(cuid())
  name          String
  url           String
  method        String       @default("POST")
  events        String[]     @default([])
  eventTypes    String[]     @default([])
  conditions    Json         @default("[]")
  headers       Json         @default("[]")
  payloadFields Json         @default("[]")
  enabled       Boolean      @default(true)
  active        Boolean      @default(true)
  secret        String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?
  logs          WebhookLog[]

  @@index([active, enabled, deletedAt])
}

// 9. Webhook Configuration (Global)
model WebhookConfig {
  id                  Int      @id @default(1)
  customHeaders       Json     @default("[]")
  globalPayloadFields Json     @default("[]")
  signingSecret       String   @default("")
  maxRetries          Int      @default(1)
  retryDelayMs        Int      @default(2000)
  timeoutMs           Int      @default(5000)
  updatedAt           DateTime @default(now()) @updatedAt
}

// 10. Webhook Outgoing Delivery Logs
model WebhookLog {
  id                String              @id @default(cuid())
  subscriptionId    String
  subscriptionName  String?
  subscription      WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event             String
  url               String
  method            String              @default("POST")
  conditionsMatched Boolean             @default(true)
  conditionDetails  String?
  payload           Json
  status            String
  statusCode        Int?
  responseCode      Int?
  response          String?             @db.Text
  responseBody      String?             @db.Text
  error             String?             @db.Text
  retryCount        Int                 @default(0)
  durationMs        Int                 @default(0)
  triggeredAt       DateTime            @default(now())
  createdAt         DateTime            @default(now())

  @@index([subscriptionId, createdAt])
  @@index([triggeredAt])
}

// 11. Incoming Webhooks (Integrations)
model IncomingWebhook {
  id          String    @id @default(cuid())
  name        String
  token       String    @unique @default(cuid())
  source      String    @default("custom")
  branchId    String?
  fieldMap    Json?
  active      Boolean   @default(true)
  totalHits   Int       @default(0)
  lastHitAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([token, active])
}


// 12. Converted Leads & All Enrollments (Walk-in, Online, Direct, Referral)
model ConvertedLead {
  id              String    @id @default(cuid())
  leadOwner       String?
  studentId       String?
  studentName     String
  studentEmail    String?
  studentPhone    String?
  course          String
  branchId        String
  branchName      String?
  location        String?
  counselorId     String?
  counselorName   String?
  counselor       CounselorProfile? @relation("CounselorConvertedLeads", fields: [counselorId], references: [id], onDelete: SetNull)
  leadSource      String    @default("Direct") // Walk-in, Online, Website, Referral, Direct
  feePaid         Float?    @default(0)
  totalFee        Float?    @default(0)
  status          String    @default("Enrolled") // Enrolled, Admitted, Joined
  enrollmentDate  DateTime  @default(now())
  notes           String?   @db.Text
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  deletedAt       DateTime?

  @@index([branchId])
  @@index([counselorId])
  @@index([enrollmentDate])
  @@index([status])
}


// 13. Counselor Attendance & Daily Shift Logs
model CounselorAttendance {
  id                    String            @id @default(cuid())
  counselorId           String
  counselor             CounselorProfile  @relation("CounselorAttendances", fields: [counselorId], references: [id], onDelete: Cascade)
  date                  String            // YYYY-MM-DD
  clockIn               DateTime          @default(now())
  clockOut              DateTime?
  status                String            @default("CLOCKED_IN") // CLOCKED_IN, ON_BREAK, IN_SESSION, BUFFER, CLOCKED_OUT
  totalWorkMinutes      Int               @default(0)
  totalBreakMinutes     Int               @default(0)
  totalSessionMinutes   Int               @default(0)
  totalBufferMinutes    Int               @default(0)
  totalAvailableMinutes Int               @default(0)
  notes                 String?           @db.Text
  breaks                CounselorBreak[]  @relation("AttendanceBreaks")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  deletedAt             DateTime?

  @@unique([counselorId, date])
  @@index([counselorId, date, status])
  @@index([date, status])
}

// 14. Counselor Break & Buffer Intervals
model CounselorBreak {
  id              String               @id @default(cuid())
  attendanceId    String
  attendance      CounselorAttendance  @relation("AttendanceBreaks", fields: [attendanceId], references: [id], onDelete: Cascade)
  counselorId     String
  counselor       CounselorProfile     @relation("CounselorBreaks", fields: [counselorId], references: [id], onDelete: Cascade)
  breakType       String               // Lunch, Tea Break, Personal, Meeting, SessionBuffer
  startTime       DateTime             @default(now())
  endTime         DateTime?
  durationMinutes Int?                 @default(0)
  reason          String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  @@index([attendanceId, counselorId, breakType])
  @@index([startTime, endTime])
}
